# ─── Arcade Game Server Environment Variables ───────────────────────────────
# Copy this file to .env in the server/ directory and fill in real values.
# server/.env is gitignored and should NEVER be committed.

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED: Long random secret for signing JWT tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_very_long_random_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# The origin of the deployed React client (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, great for local dev / single-server)
# The path is relative to the server directory
DATABASE_URL=file:../arcade.db

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Only set this if you want Socket.io Redis Pub/Sub (enables multi-instance scaling)
# REDIS_URL=redis://localhost:6379
